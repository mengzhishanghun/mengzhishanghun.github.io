---
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import {ui,links,href,type Lang} from '../data/site';
interface Props{lang:Lang;title?:string;description?:string;area?:string;}
const {lang,title,description,area=''}=Astro.props;const t=ui[lang];
const alternate=Astro.url.pathname.replace(/^\/(zh|en)(\/|$)/,'/'+(lang==='zh'?'en':'zh')+'$2');
const nav=[['projects',t.projects],['docs',t.docs],['blog',t.blog],['me',t.me]];
---
<!doctype html><html lang={lang==='zh'?'zh-CN':'en'}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content={description??t.description}/><meta name="theme-color" content="#f7f9fc"/><title>{title?title+' · MZSH':'MZSH · '+t.brand}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body>
<a class="skip-link" href="#main">{lang==='zh'?'跳到主要内容':'Skip to content'}</a>
<header class="site-header"><div class="container header-inner"><a class="brand" href={href(lang)}><span class="brand-word">MZSH<span>•</span></span><span class="brand-description">{t.brand}</span></a><button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="main-navigation" aria-label={lang==='zh'?'展开导航':'Open navigation'}><Icon name="menu"/></button><nav class="main-nav" id="main-navigation" aria-label={lang==='zh'?'主导航':'Main navigation'}>{nav.map(([key,label])=><a href={href(lang,key)} aria-current={area===key?'page':undefined}>{label}</a>)}</nav><div class="header-actions"><a class="language-switch" href={alternate} lang={lang==='zh'?'en':'zh-CN'} aria-label={lang==='zh'?'Switch to English':'切换中文'}>{lang==='zh'?'EN':'中'}</a><a class="button button-small button-dark header-contact" href={href(lang,'me')+'#contact'}>{t.contact}<Icon size={16}/></a></div></div></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="container footer-top"><div><a class="brand-word" href={href(lang)}>MZSH<span>•</span></a><p>{t.footer}</p></div><div class="footer-links"><a href={links.github} target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" size={14}/></a><a href={links.fab} target="_blank" rel="noopener noreferrer">Fab<Icon name="external" size={14}/></a><a href={'mailto:'+links.email}>{lang==='zh'?'邮件联系':'Email'}<Icon name="mail" size={15}/></a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} MZSH · {lang==='zh'?'独立开发 · 远程协作':'Independent development · Remote collaboration'}</span><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">晋ICP备2026011728号-1</a><a href="https://beian.mps.gov.cn/" target="_blank" rel="noopener noreferrer">晋公网安备14082502000144号</a></div></footer>
<script>const toggle=document.querySelector<HTMLButtonElement>('[data-menu-toggle]');const nav=document.getElementById('main-navigation');const close=()=>{toggle?.setAttribute('aria-expanded','false');nav?.classList.remove('is-open');};toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open);});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){close();toggle.focus();}});document.addEventListener('click',e=>{if(e.target instanceof Node&&!nav?.contains(e.target)&&!toggle?.contains(e.target))close();});</script>
</body></html>
