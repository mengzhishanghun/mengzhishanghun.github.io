---
import '../styles/site.css';
import '../styles/content-media.css';
import { ClientRouter } from 'astro:transitions';
import SiteChrome from '../../../shared/SiteChrome.astro';
import MediaViewer from '../components/MediaViewer.astro';
interface Props { title?: string; description?: string; area?: string; }
const { title, description = '梦之殇魂的作品、案例与技术记录。', area = '' } = Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#07101d"/><title>{title ? `${title} · 梦之殇魂` : '梦之殇魂'}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="alternate" type="application/rss+xml" title="梦之殇魂博客 RSS" href="/blog/rss.xml"/><ClientRouter/></head><body class:list={{'home-page': area === 'home'}}><SiteChrome area={area}><slot/></SiteChrome><MediaViewer/></body></html>
