---
import '../styles/site.css';
import { links } from '../data/site';
interface Props { title?: string; description?: string; area?: string; }
const { title, description = '梦之殇魂的作品、案例与技术记录。', area = '' } = Astro.props;
const nav = [['/', '首页', 'home'], ['/works/', '作品', 'works'], ['/cases/', '案例', 'cases'], ['/blog/', '博客', 'blog']];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#07101d"/><title>{title ? `${title} · 梦之殇魂` : '梦之殇魂'}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="alternate" type="application/rss+xml" title="梦之殇魂博客 RSS" href="/blog/rss.xml"/></head><body>
<a class="skip-link" href="#main">跳到主要内容</a><header class="site-header"><div class="shell header-inner"><a class="brand" href="/" aria-label="梦之殇魂首页">MZSH</a><button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="main-navigation">菜单</button><nav id="main-navigation" class="main-nav" aria-label="主导航">{nav.map(([href,label,key])=><a href={href} aria-current={area===key?'page':undefined}>{label}</a>)}</nav></div></header>
<main id="main" class:list={{'home-main':area==='home'}}><slot/></main>
<footer class="site-footer"><div class="shell legal-footer"><span>© 2026 MZSH</span><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">晋ICP备2026011728号-1</a><a href="https://beian.mps.gov.cn/" target="_blank" rel="noopener noreferrer">晋公网安备14082502000144号</a></div></footer>
<div class="floating-actions"><button type="button" data-open-dialog="contact">✉<span>联系</span></button><button type="button" data-open-dialog="support">♡<span>支持</span></button></div><dialog data-quick-dialog><button class="dialog-close" data-dialog-close aria-label="关闭">×</button><section data-dialog-panel="contact"><h2>联系我</h2><p>合作咨询、作品反馈或技术交流，可通过下面的方式联系。</p><div class="contact-email"><span>邮箱</span><a class="email-link" href={'mailto:'+links.email}>{links.email}</a><button type="button" class="copy-email" data-copy-email>复制</button><small data-copy-feedback role="status"></small></div><p class="wechat-note">扫码添加微信 →</p><div class="code-placeholder">个人微信二维码<br/>待替换</div></section><section data-dialog-panel="support" hidden><h2>支持创作</h2><p>如果这些作品或文章对你有帮助，可以自愿支持我继续创作。</p><div class="support-codes"><div class="code-placeholder">微信赞赏码<br/>待替换</div><div class="code-placeholder">支付宝收款码<br/>待替换</div></div><small>自愿支持，不对应商品或服务。</small></section></dialog>
<script define:vars={{email:links.email}}>const t=document.querySelector('[data-menu-toggle]'),n=document.querySelector('.main-nav'),d=document.querySelector('[data-quick-dialog]'),feedback=document.querySelector('[data-copy-feedback]');t?.addEventListener('click',()=>{const o=t.getAttribute('aria-expanded')!=='true';t.setAttribute('aria-expanded',String(o));n?.classList.toggle('is-open',o)});document.querySelectorAll('[data-open-dialog]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-dialog-panel]').forEach(p=>p.toggleAttribute('hidden',p.getAttribute('data-dialog-panel')!==b.getAttribute('data-open-dialog')));d?.showModal()}));document.querySelector('[data-dialog-close]')?.addEventListener('click',()=>d?.close());d?.addEventListener('click',e=>{if(e.target===d)d.close()});document.querySelector('[data-copy-email]')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(email);if(feedback)feedback.textContent='邮箱已复制'}catch{if(feedback)feedback.textContent='请手动复制邮箱'}});</script>
</body></html>
