---
// 与文档区共用主题偏好；auto 仅表示跟随系统，实际主题只有浅色和深色。
---
<script is:inline>
(() => {
  const key = 'starlight-theme';
  const system = window.matchMedia('(prefers-color-scheme: light)');
  const parse = value => value === 'light' || value === 'dark' ? value : 'auto';
  const load = () => { try { return parse(localStorage.getItem(key)); } catch { return 'auto'; } };
  let preference = load();
  const apply = () => {
    const theme = preference === 'auto' ? (system.matches ? 'light' : 'dark') : preference;
    document.documentElement.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#0b0c0f' : '#f7f9fc');
    document.querySelectorAll('[data-theme-select]').forEach(select => { select.value = preference; });
  };
  apply();
  system.addEventListener('change', () => { if (preference === 'auto') apply(); });
  window.addEventListener('storage', event => {
    if (event.key === key || event.key === null) { preference = load(); apply(); }
  });
  document.addEventListener('DOMContentLoaded', () => {
    apply();
    document.querySelectorAll('[data-theme-select]').forEach(select => {
      select.addEventListener('change', () => {
        preference = parse(select.value);
        try { localStorage.setItem(key, preference === 'auto' ? '' : preference); } catch {}
        apply();
      });
    });
  }, { once: true });
})();
</script>
