---
import {render,type CollectionEntry} from 'astro:content';
import Base from '../layouts/Base.astro';
import RelatedContent from '../../../shared/RelatedContent.astro';
import {getPublishedPosts,postHref} from '../../../shared/blog';
interface Props{post:CollectionEntry<'blog'>;draftPreview?:boolean;}
const {post,draftPreview=false}=Astro.props;const {lang}=post.data;const zh=lang==='zh';
const {Content}=await render(post);
const translation=(await getPublishedPosts()).find(item=>item.data.translationKey===post.data.translationKey&&item.data.lang!==lang);
const alternateHref=translation?postHref(translation):'/'+(zh?'en':'zh')+'/blog/';
---
<Base lang={lang} title={post.data.title} description={post.data.description} area="blog" alternateHref={alternateHref}><div class="container detail-back"><a class="text-link" href={'/'+lang+'/blog/'}>← {zh?'博客':'Blog'}</a></div><article class="container article-page" data-blog-article={!draftPreview?true:undefined} data-pagefind-body={!draftPreview?true:undefined}><header class="article-header">{draftPreview&&<p class="draft-notice">{zh?'草稿预览 · 不进入文章列表、搜索或 RSS':'Draft preview · Excluded from listings, search, and RSS'}</p>}<div class="article-meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time>{post.data.tags.map(tag=><a class="article-tag" data-pagefind-filter="tag" href={'/'+lang+'/blog/?tag='+encodeURIComponent(tag)}>{tag}</a>)}</div><h1 data-pagefind-meta="title">{post.data.title}</h1><p>{post.data.description}</p></header><div class="prose"><Content/></div>{!draftPreview&&<RelatedContent contentKey={'blog:'+post.data.slug} lang={lang}/>}</article></Base>
