---
import {products,ui,href,type Lang} from '../data/site';import Icon from './Icon.astro';
interface Props{product:typeof products[number];lang:Lang;}
const {product,lang}=Astro.props;const detail=product[lang];
---
<article class={'product-card '+product.color} data-product-category={product.category}><a class="product-identity" href={href(lang,'projects',product.id)} aria-label={product.name}><span class="product-mark">{product.mark}</span><span class="product-category">{detail.label}</span><Icon name="external" size={18}/></a><div class="product-body"><h3><a href={href(lang,'projects',product.id)}>{product.name}</a></h3><p>{detail.description}</p><div class="card-bottom"><span class="small-tag">{product.license?product.license:(lang==='zh'?'公开源码':'Public source')}</span><a class="text-link" href={href(lang,'projects',product.id)}>{ui[lang].detail}<Icon size={17}/></a></div></div></article>
