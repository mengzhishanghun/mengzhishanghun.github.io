---
import { render } from 'astro:content';
interface Props { items: any[]; label: string; selectedSlug?: string; baseHref: '/works/' | '/cases/' | '/blog/'; }
const { items, label, baseHref, selectedSlug = items[0]?.data.slug } = Astro.props;
const selected = items.find(item => item.data.slug === selectedSlug) ?? items[0];
const groups = [...new Map(items.map(item => [item.data.categoryId, { id:item.data.categoryId, name:item.data.categoryName, order:item.data.categoryOrder, items:items.filter(candidate => candidate.data.categoryId===item.data.categoryId) }])).values()].sort((a,b) => a.order-b.order);
const { Content } = selected ? await render(selected) : { Content: () => null };
---
<div class="master-detail"><details class="master-directory" open><summary class="master-directory-toggle">{label}</summary><nav class="master-nav" aria-label={label}>{groups.map(group=><details class="master-group" open={group.id===selected?.data.categoryId}><summary>{group.name}</summary><div>{group.items.map(item=><a href={baseHref+item.data.slug+'/'} aria-current={item.data.slug===selected?.data.slug?'page':undefined}>{item.data.title}</a>)}</div></details>)}</nav></details>{selected?<article class="master-panel" aria-labelledby={'detail-'+selected.data.slug} data-pagefind-body data-blog-article={baseHref==='/blog/'&&selectedSlug?true:undefined}><header class="item-heading"><div>{selected.data.date&&<p class="eyebrow">{selected.data.date.toISOString().slice(0,10)}{selected.data.tags?.length>0&&`　${selected.data.tags.join(' · ')}`}</p>}<h1 id={'detail-'+selected.data.slug} data-pagefind-meta="title">{selected.data.title}</h1><span class="status-badge">{selected.data.status}</span></div><p>{selected.data.description}</p></header>{selected.data.links.length>0&&<p class="item-links">{selected.data.links.map((link:any)=><a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} →</a>)}</p>}<div class="prose"><Content/></div><slot name="after"/></article>:<p class="master-empty">内容正在整理中。</p>}</div>
<script define:vars={{baseHref,ids:items.map(item=>item.data.slug)}} data-astro-rerun>const nav=document.currentScript?.previousElementSibling?.querySelector?.('.master-nav');nav?.querySelectorAll('.master-group').forEach(group=>group.addEventListener('toggle',()=>{if(group.open)nav.querySelectorAll('.master-group').forEach(other=>{if(other!==group)other.open=false})}));const legacyId=location.hash.slice(1);if(legacyId&&ids.includes(legacyId))location.replace(baseHref+legacyId+'/');</script>
