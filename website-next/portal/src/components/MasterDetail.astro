---
export type DetailSection = { heading: string; content: string | string[] };
export type MasterItem = { id: string; navTitle: string; title: string; status: string; description: string; details: DetailSection[]; links: { label: string; href: string }[] };
interface Props { items: MasterItem[]; label: string; selectedId?: string; baseHref: '/works/' | '/cases/'; }
const { items, label, baseHref, selectedId = items[0]?.id } = Astro.props;
const selected = items.find(item => item.id === selectedId) ?? items[0];
---
<div class="master-detail"><nav class="master-nav" aria-label={label}>{items.map(item=><a href={baseHref+item.id+'/'} aria-current={item.id===selected.id?'page':undefined}>{item.navTitle}</a>)}</nav><article class="master-panel" aria-labelledby={'detail-'+selected.id}><div class="item-heading"><div><h2 id={'detail-'+selected.id}>{selected.title}</h2><span class="status-badge">{selected.status}</span></div><p>{selected.description}</p></div>{selected.links.length>0&&<div class="item-links">{selected.links.map(link=><a class="text-link" href={link.href} target={link.href.startsWith('http')?'_blank':undefined} rel={link.href.startsWith('http')?'noopener noreferrer':undefined}>{link.label} →</a>)}</div>}<div class="item-details">{selected.details.map(detail=><section><h3>{detail.heading}</h3>{Array.isArray(detail.content)?<ul>{detail.content.map(line=><li>{line}</li>)}</ul>:<p>{detail.content}</p>}</section>)}</div></article></div>
<script define:vars={{baseHref,ids:items.map(item=>item.id)}} data-astro-rerun>const legacyId=location.hash.slice(1);if(legacyId&&ids.includes(legacyId))location.replace(baseHref+legacyId+'/');</script>
<style is:global>.master-nav a{display:block;width:100%}@media(max-width:720px){.master-nav a{display:inline-block;width:auto;min-width:max-content}}</style>
