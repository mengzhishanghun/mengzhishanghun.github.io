---
export type DetailSection = { heading: string; content: string | string[] };
export type MasterItem = { id: string; navTitle: string; title: string; status: string; description: string; details: DetailSection[]; links: { label: string; href: string }[] };
interface Props { items: MasterItem[]; label: string; }
const { items, label } = Astro.props;
---
<div class="master-detail" data-master-detail><div class="master-nav" role="tablist" aria-label={label}>{items.map((item,index)=><button type="button" role="tab" id={'tab-'+item.id} aria-controls={'panel-'+item.id} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-master-tab={item.id}>{item.navTitle}</button>)}</div><div class="master-panels">{items.map((item,index)=><article class="master-panel" id={'panel-'+item.id} role="tabpanel" aria-labelledby={'tab-'+item.id} data-master-panel={item.id} hidden={index!==0}><div class="item-heading"><div><h2>{item.title}</h2><span class="status-badge">{item.status}</span></div><p>{item.description}</p></div>{item.links.length>0&&<div class="item-links">{item.links.map(link=><a class="text-link" href={link.href} target={link.href.startsWith('http')?'_blank':undefined} rel={link.href.startsWith('http')?'noopener noreferrer':undefined}>{link.label} →</a>)}</div>}<div class="item-details">{item.details.map(detail=><section><h3>{detail.heading}</h3>{Array.isArray(detail.content)?<ul>{detail.content.map(line=><li>{line}</li>)}</ul>:<p>{detail.content}</p>}</section>)}</div></article>)}</div></div>
<script>const root=document.querySelector('[data-master-detail]');if(root){const tabs=[...root.querySelectorAll('[data-master-tab]')],panels=[...root.querySelectorAll('[data-master-panel]')];const choose=(id,writeHash)=>{const tab=tabs.find(node=>node.getAttribute('data-master-tab')===id);if(!tab)return;tabs.forEach(node=>{const active=node===tab;node.setAttribute('aria-selected',String(active));node.tabIndex=active?0:-1});panels.forEach(node=>node.toggleAttribute('hidden',node.getAttribute('data-master-panel')!==id));if(writeHash)history.replaceState(null,'','#'+id)};const initial=location.hash.slice(1);choose(initial,false);tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>choose(tab.getAttribute('data-master-tab'),true));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowDown'||event.key==='ArrowRight')next=(index+1)%tabs.length;if(event.key==='ArrowUp'||event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;if(event.key==='Home')next=0;if(event.key==='End')next=tabs.length-1;if(next!==index){event.preventDefault();tabs[next].focus();choose(tabs[next].getAttribute('data-master-tab'),true)}})});addEventListener('hashchange',()=>choose(location.hash.slice(1),false))}</script>
