---
import { render } from 'astro:content';
import WorkActions from './WorkActions.astro';
import ArticleOutline from './ArticleOutline.astro';
interface Props { items: any[]; label: string; selectedSlug?: string; baseHref: '/works/' | '/cases/' | '/blog/'; }
const { items, baseHref, selectedSlug = items[0]?.data.slug } = Astro.props;
const selected = items.find(item => item.data.slug === selectedSlug) ?? items[0];
const { Content, headings } = selected ? await render(selected) : { Content: () => null, headings: [] };
const backLabel = { '/works/': '返回作品列表', '/cases/': '返回案例列表', '/blog/': '返回博客列表' }[baseHref];
---
<div class="master-detail">
  {selected && <ArticleOutline headings={headings} backHref={baseHref} backLabel={backLabel}/>}
  {selected ? <article class="master-panel" aria-labelledby={'detail-'+selected.data.slug} data-pagefind-body data-blog-article={baseHref==='/blog/'&&selectedSlug?true:undefined}>
    <header class="item-heading">
      <div>
        {(selected.data.date||selected.data.tags?.length>0)&&<p class="eyebrow">{selected.data.date?.toISOString().slice(0,10)}{selected.data.date&&selected.data.tags?.length>0&&'　'}{selected.data.tags?.join(' · ')}</p>}
        <h1 id={'detail-'+selected.data.slug} data-pagefind-meta="title">{selected.data.title}</h1>
        <span class="status-badge">{selected.data.status}</span>
      </div>
      <p>{selected.data.description}</p>
    </header>
    {baseHref==='/works/'&&<WorkActions purchaseUrl={selected.data.purchaseUrl} documentationUrl={selected.data.documentationUrl}/>}
    {selected.data.links.length>0&&<p class="item-links">{selected.data.links.map((link:any)=><a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} →</a>)}</p>}
    <div class="prose"><Content/></div>
    <slot name="after"/>
  </article> : <p class="master-empty">内容正在整理中。</p>}
</div>
