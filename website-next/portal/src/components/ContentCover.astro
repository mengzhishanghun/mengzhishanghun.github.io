---
interface Props { source?: string; index: number; }
const { source, index } = Astro.props;
const variant = index % 3;
---
<div class:list={['content-cover', `content-cover-${variant}`]} aria-hidden="true">
  {source ? <img src={source} alt="" width="960" height="540" loading="lazy" decoding="async" /> : <svg viewBox="0 0 480 240" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path class="cover-grid" d="M0 60H480M0 120H480M0 180H480M80 0V240M160 0V240M240 0V240M320 0V240M400 0V240" />
    <ellipse class="cover-orbit" cx="240" cy="120" rx="159" ry="77" transform="rotate(-15 240 120)" />
    {variant === 0 && <>
      <path class="cover-line" d="M141 120H206M274 120H340" />
      {[110, 240, 370].map(x => <g transform={`translate(${x} 120)`}>
        <path class="cover-shape" d="M0-37 34-18V20L0 39-34 20V-18Z" />
        <path class="cover-line" d="M-34-18 0 1 34-18M0 1V39" />
      </g>)}
    </>}
    {variant === 1 && <>
      <path class="cover-line" d="M130 77H186V120H210M270 120H305V169H350M270 120H305V72H350" />
      <rect class="cover-shape" x="82" y="51" width="62" height="62" rx="10" />
      <rect class="cover-shape" x="205" y="85" width="70" height="70" rx="12" />
      <rect class="cover-shape" x="340" y="41" width="54" height="54" rx="9" />
      <rect class="cover-shape" x="340" y="146" width="54" height="54" rx="9" />
      <path class="cover-symbol" d="M228 109H252M228 120H252M228 131H245M99 73H127M99 86H122M357 167H377M357 179H377" />
    </>}
    {variant === 2 && <>
      <circle class="cover-orbit" cx="240" cy="120" r="82" />
      <circle class="cover-shape" cx="240" cy="120" r="51" />
      <path class="cover-play" d="M229 98 264 120 229 142Z" />
      <circle class="cover-dot" cx="386" cy="87" r="4" /><circle class="cover-dot" cx="91" cy="148" r="4" />
    </>}
  </svg>}
</div>
