---
import Base from '../layouts/Base.astro';
import { published } from '../../../shared/content';
import { getPublishedPosts } from '../../../shared/blog';
const works=(await published('works')).filter((item:any)=>item.data.featured).slice(0,3);
const cases=(await published('cases')).filter((item:any)=>item.data.featured).slice(0,3);
const posts=(await getPublishedPosts()).filter(post=>post.data.lang==='zh').slice(0,3);
const sections=[['作品',works,'/works/'],['案例',cases,'/cases/'],['博客',posts,'/blog/']];
---
<Base area="home"><section class="hero"><div class="shell hero-content"><h1>所有复杂，皆可封装；<br/>所有重复，皆可自动化。</h1><p>你好，我是小毛，欢迎来到我的个人网站。</p><section class="direction-list" aria-label="发展方向"><h2>发展方向</h2><p>游戏与互动内容　·　数字孪生与仿真　·　AI 内容与漫剧　·　增长与投放实践</p></section></div></section><section class="shell section home-featured">{sections.map(([label,items,href]:any)=><section><h2>{label}</h2><div class="card-grid">{items.map((item:any)=><a class="card" href={href+item.data.slug+'/'}><h3>{item.data.title}</h3><p>{item.data.description}</p></a>)}</div></section>)}</section></Base>
