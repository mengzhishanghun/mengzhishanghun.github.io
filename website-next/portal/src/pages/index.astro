---
import Base from '../layouts/Base.astro';

const featured = {
  works: [
    { title: 'UEPluginAutoPacker', description: '把多引擎版本构建、打包日志与 Fab 包整理集中到一处，减少重复操作，也更容易定位构建失败的原因。', href: '/works/plugin-auto-packer/' },
    { title: 'UEPluginManager', description: '统一查找项目、引擎与商城插件，集中查看插件位置、版本与依赖关系。', href: '/works/plugin-manager/' },
    { title: 'MDBlogPacker', description: '处理 Markdown 文章中的本地图片，让内容更方便复制和发布到不同平台。', href: '/works/md-blog-packer/' },
  ],
  cases: [
    { title: '解决驾考模拟器三屏显示不一致问题', description: '围绕三屏环境中的 Lumen GI 与曝光差异，定位引擎限制并验证修改后的显示结果。', href: '/cases/driving-simulator-three-screen/' },
    { title: '集成 AI 数字人交互流程', description: '把语音识别、对话、语音合成、表情驱动与人体交互串成可以实际演示的完整流程。', href: '/cases/ai-digital-human-integration/' },
    { title: '插件开发到发布的工具链', description: '将插件管理、多版本构建、日志检查与交付整理成连贯的开发和发布流程。', href: '/cases/plugin-release-workflow/' },
  ],
  blog: [
    { title: 'Markdown 本地图片，发布时该怎么处理？', description: '梳理相对路径、独立图片文件与 Base64 内嵌的适用场景，帮助文章在不同平台间稳定发布。', href: '/blog/markdown-images/' },
  ],
};
---
<Base area="home">
  <div class="home-layout">
    <section class="hero">
      <div class="shell hero-content">
        <h1>所有复杂，皆可封装；<br/>所有重复，皆可自动化。</h1>
        <p>你好，我是小毛。这里记录我正在实践的技术、内容与产品方向。</p>
        <p class="home-direction-list" aria-label="目前关注的方向">游戏与互动内容<span>·</span>数字孪生与仿真<span>·</span>AI 内容与漫剧<span>·</span>增长与投放实践</p>
      </div>
    </section>

    <section class="section featured-section" aria-label="精选内容">
      <div class="shell">
        <div class="featured-shell">
          <div class="featured-tabs" role="tablist" aria-label="精选内容分类">
            <button class="active" type="button" role="tab" aria-selected="true" data-tab="works">01　作品<small>做过的插件、工具与项目</small></button>
            <button type="button" role="tab" aria-selected="false" data-tab="cases">02　案例<small>从真实问题到落地结果</small></button>
            <button type="button" role="tab" aria-selected="false" data-tab="blog">03　博客<small>技术思考、排障与开发记录</small></button>
          </div>
          <section class="featured-panel" aria-live="polite">
            <p class="eyebrow" data-label>精选作品 01</p>
            <div class="featured-card" tabindex="0" data-feature></div>
            <div class="featured-dots" data-dots></div>
            <a class="featured-more text-link" data-feature-more href="/works/">查看更多作品 →</a>
          </section>
        </div>
      </div>
    </section>
  </div>
</Base>

<script define:vars={{ featured }} data-astro-rerun>
  const groups = featured;
  let group = 'works';
  let index = 0;
  let startX = 0;
  const card = document.querySelector('[data-feature]');
  const dots = document.querySelector('[data-dots]');
  const label = document.querySelector('[data-label]');
  const more = document.querySelector('[data-feature-more]');
  const names = { works: '精选作品', cases: '精选案例', blog: '精选博客' };
  const moreText = { works: '查看更多作品 →', cases: '查看更多案例 →', blog: '查看更多博客 →' };
  const moreHref = { works: '/works/', cases: '/cases/', blog: '/blog/' };

  const render = () => {
    const items = groups[group];
    const item = items[index] || items[0];
    label.textContent = `${names[group]} ${String(index + 1).padStart(2, '0')}`;
    more.textContent = moreText[group];
    more.href = moreHref[group];
    card.innerHTML = `<h3><a href="${item.href}">${item.title}</a></h3><p>${item.description}</p>`;
    dots.innerHTML = items.length > 1
      ? items.map((_, itemIndex) => `<button class="${itemIndex === index ? 'active' : ''}" type="button" aria-label="查看第 ${itemIndex + 1} 项" aria-current="${itemIndex === index ? 'true' : 'false'}" data-index="${itemIndex}"></button>`).join('')
      : '';
    dots.querySelectorAll('button').forEach(button => button.addEventListener('click', () => {
      index = Number(button.dataset.index);
      render();
    }));
  };

  const move = direction => {
    const itemCount = groups[group].length;
    if (itemCount > 1) {
      index = (index + direction + itemCount) % itemCount;
      render();
    }
  };

  document.querySelectorAll('[data-tab]').forEach(button => button.addEventListener('click', () => {
    group = button.dataset.tab;
    index = 0;
    document.querySelectorAll('[data-tab]').forEach(tab => {
      const active = tab === button;
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-selected', String(active));
    });
    render();
  }));
  card.addEventListener('pointerdown', event => startX = event.clientX);
  card.addEventListener('pointerup', event => {
    if (Math.abs(event.clientX - startX) > 45) move(event.clientX < startX ? 1 : -1);
  });
  card.addEventListener('keydown', event => {
    if (event.key === 'ArrowLeft') move(-1);
    if (event.key === 'ArrowRight') move(1);
  });
  render();
</script>

<style>
  .home-direction-list{display:flex;flex-wrap:wrap;gap:0 10px;max-width:820px!important;margin-top:14px;font-size:.92rem!important}
  .home-direction-list span{color:var(--blue)}
  .featured-card{touch-action:pan-y}
  .featured-card h3{font-size:clamp(1.65rem,3vw,2.2rem);line-height:1.25;margin:22px 0 15px}
  .featured-card h3 a:hover,.featured-card h3 a:focus-visible{color:var(--blue)}
  .featured-card p{max-width:760px;font-size:1rem}
  @media(max-width:720px){.home-direction-list{display:block;line-height:1.9}.home-direction-list span{padding:0 5px}.featured-card h3{font-size:1.45rem}}
</style>
