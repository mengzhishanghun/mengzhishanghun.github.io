---
import Base from '../layouts/Base.astro';
import { products, cases } from '../data/site';
import { getPublishedPosts } from '../../../shared/blog';
const posts = (await getPublishedPosts()).filter(post => post.data.lang === 'zh').slice(0, 3);
const featured = { works: products.slice(0, 3).map(p => ({ title: p.name, description: p.zh.description, href: `/works/${p.id}/` })), cases: cases.map(c => ({ title: c.zh.title, description: c.zh.summary, href: `/cases/${c.id}/` })), blog: posts.map(p => ({ title: p.data.title, description: p.data.description, href: `/blog/${p.data.slug}/` })) };
---
<Base area="home"><div class="home-layout"><section class="hero"><div class="shell hero-content"><h1>所有复杂，皆可封装；<br/>所有重复，皆可自动化。</h1><p>你好，我是小毛，欢迎来到我的个人网站。</p></div></section><section class="section featured-section"><div class="shell"><div class="featured-shell"><div class="featured-tabs" role="tablist"><button class="active" data-tab="works">01　作品<small>做过的插件、工具与项目</small></button><button data-tab="cases">02　案例<small>从真实问题到落地结果</small></button><button data-tab="blog">03　博客<small>技术思考、排障与开发记录</small></button></div><section class="featured-panel" aria-live="polite"><p class="eyebrow" data-label>精选作品</p><div class="featured-card" tabindex="0" data-feature></div><div class="featured-dots" data-dots></div><a class="featured-more text-link" data-feature-more href="/works/">查看更多作品 →</a></section></div></div></section></div></Base>
<script define:vars={{ featured }}>const groups=featured;let group='works',index=0,startX=0;const card=document.querySelector('[data-feature]'),dots=document.querySelector('[data-dots]'),label=document.querySelector('[data-label]'),more=document.querySelector('[data-feature-more]');const names={works:'精选作品',cases:'精选案例',blog:'精选博客'},moreText={works:'查看更多作品 →',cases:'查看更多案例 →',blog:'查看更多博客 →'},moreHref={works:'/works/',cases:'/cases/',blog:'/blog/'},render=()=>{const items=groups[group],item=items[index]||items[0];label.textContent=names[group];more.textContent=moreText[group];more.href=moreHref[group];card.innerHTML=`<h3><a href="${item.href}">${item.title}</a></h3><p>${item.description}</p>`;dots.innerHTML=items.map((_,i)=>`<button class="${i===index?'active':''}" aria-label="查看第${i+1}项" data-index="${i}"></button>`).join('');dots.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{index=Number(b.dataset.index);render()}))},move=d=>{const n=groups[group].length;if(n>1){index=(index+d+n)%n;render()}};document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{group=b.dataset.tab;index=0;document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));render()}));card.addEventListener('pointerdown',e=>startX=e.clientX);card.addEventListener('pointerup',e=>{if(Math.abs(e.clientX-startX)>45)move(e.clientX<startX?1:-1)});card.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')move(-1);if(e.key==='ArrowRight')move(1)});render();</script>
