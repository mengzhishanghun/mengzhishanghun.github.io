---
import Base from '../layouts/Base.astro';
import { published } from '../../../shared/content';
import { getCategorizedPosts, postHref } from '../../../shared/blog';

const selected = {
  works: ['plugin-auto-packer', 'plugin-manager', 'md-blog-packer'],
  cases: ['driving-simulator-three-screen', 'ai-digital-human-integration', 'plugin-release-workflow'],
  blog: ['markdown-images'],
};
const pick = <T extends { data: { slug: string } }>(items: T[], slugs: string[], section: string) =>
  slugs.map((slug) => {
    const item = items.find((entry) => entry.data.slug === slug);
    if (!item) throw new Error(`Missing published homepage ${section}: ${slug}`);
    return item;
  });
const works = pick(await published('works'), selected.works, 'work');
const cases = pick(await published('cases'), selected.cases, 'case');
const blog = pick(await getCategorizedPosts('zh'), selected.blog, 'blog');
---
<Base area="home">
  <div class="home-layout">
    <section class="hero">
      <div class="shell hero-content">
        <h1>所有复杂，皆可封装；<br/>所有重复，皆可自动化。</h1>
        <div class="home-intro">
          <p>你好，我是小毛，网上常用“梦之殇魂”这个名字。</p>
          <p>这个网站放着我的作品和项目案例，也记录一些开发过程与想法。</p>
          <p>我主要从事游戏开发和数字孪生，也在学习买量投放，研究 AI 漫剧。</p>
          <p>如果你有合适的项目想找人合作，欢迎联系我聊聊。</p>
          <p>希望这里的内容能给你一点参考，也希望以后有机会一起做点有意思的事。</p>
        </div>
        <p class="home-direction-list" aria-label="目前关注的方向">游戏与互动内容<span>·</span>数字孪生与仿真<span>·</span>AI 内容与漫剧<span>·</span>增长与投放实践</p>
      </div>
    </section>

    <section class="home-section" aria-labelledby="home-works">
      <div class="shell">
        <div class="home-section-head"><div><h2 id="home-works">作品</h2><p>做过的插件、工具与项目。</p></div><a href="/works/">查看全部作品 <span aria-hidden="true">→</span></a></div>
        <div class="home-card-grid">
          {works.map((item, index) => <article class="home-card">
            <div class:list={['home-card-art', `home-art-${index + 1}`]} aria-hidden="true"><span>{String(index + 1).padStart(2, '0')}</span><i></i><b>{item.data.categoryName}</b></div>
            <div class="home-card-body"><h3><a href={`/works/${item.data.slug}/`}>{item.data.title}</a></h3><p>{item.data.description}</p><ul class="home-tags" aria-label="标签">{item.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}</ul></div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="home-cases">
      <div class="shell">
        <div class="home-section-head"><div><h2 id="home-cases">案例</h2><p>从真实问题到落地结果。</p></div><a href="/cases/">查看全部案例 <span aria-hidden="true">→</span></a></div>
        <div class="home-card-grid">
          {cases.map((item, index) => <article class="home-card">
            <div class:list={['home-card-art', `home-art-${index + 4}`]} aria-hidden="true"><span>{String(index + 1).padStart(2, '0')}</span><i></i><b>{item.data.categoryName}</b></div>
            <div class="home-card-body"><h3><a href={`/cases/${item.data.slug}/`}>{item.data.title}</a></h3><p>{item.data.description}</p><ul class="home-tags" aria-label="标签">{item.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}</ul></div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="home-section home-blog-section" aria-labelledby="home-blog">
      <div class="shell">
        <div class="home-section-head"><div><h2 id="home-blog">博客</h2><p>技术思考、排障与开发记录。</p></div><a href="/blog/">查看全部博客 <span aria-hidden="true">→</span></a></div>
        <div class="home-blog-grid">
          {blog.map((item) => <article class="home-card home-blog-card">
            <div class="home-card-art home-art-blog" aria-hidden="true"><span>01</span><i></i><b>{item.data.categoryName}</b></div>
            <div class="home-card-body"><h3><a href={postHref(item)}>{item.data.title}</a></h3><p>{item.data.description}</p><ul class="home-tags" aria-label="标签">{item.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}</ul></div>
          </article>)}
        </div>
      </div>
    </section>
  </div>
</Base>
