---
import { render } from 'astro:content'; import Base from '../../layouts/Base.astro'; import RelatedContent from '../../../../shared/RelatedContent.astro'; import { getPublishedPosts } from '../../../../shared/blog';
export async function getStaticPaths(){return (await getPublishedPosts()).filter(post=>post.data.lang==='zh').map(post=>({params:{slug:post.data.slug},props:{post}}));} const { post } = Astro.props; const { Content } = await render(post);
---
<Base title={post.data.title} area="blog" description={post.data.description}><article class="shell detail" data-blog-article data-pagefind-body><a class="text-link" href="/blog/">← 返回博客</a><p class="eyebrow">{post.data.date.toISOString().slice(0,10)}　{post.data.tags.join(' · ')}</p><h1 data-pagefind-meta="title">{post.data.title}</h1><p>{post.data.description}</p><div class="prose"><Content/></div><RelatedContent contentKey={'blog:'+post.data.slug} lang="zh"/></article></Base>
