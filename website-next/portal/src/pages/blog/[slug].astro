---
import Base from '../../layouts/Base.astro';
import MasterDetail from '../../components/MasterDetail.astro';
import RelatedContent from '../../../../shared/RelatedContent.astro';
import { getCategorizedPosts } from '../../../../shared/blog';
export async function getStaticPaths(){return (await getCategorizedPosts('zh')).map(post=>({params:{slug:post.data.slug},props:{post}}));}
const { post } = Astro.props;
const posts = await getCategorizedPosts('zh');
---
<Base title={post.data.title} area="blog" description={post.data.description}><div class="master-page"><header class="shell master-page-head"><p class="master-section-title">博客</p><p>技术思考、排障与开发记录。</p></header><section class="shell master-page-body"><MasterDetail items={posts} selectedSlug={post.data.slug} label="博客目录" baseHref="/blog/"><RelatedContent slot="after" contentKey={'blog:'+post.data.slug} lang="zh"/></MasterDetail></section></div></Base>
