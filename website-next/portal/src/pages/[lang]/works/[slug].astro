---
import Base from '../../../layouts/Base.astro';
import RelatedContent from '../../../../../shared/RelatedContent.astro';
import {languages,works,products,href,type Lang} from '../../../data/site';
export function getStaticPaths(){return languages.flatMap(lang=>works.map(work=>({params:{lang,slug:work.id},props:{work}})));}
const lang=Astro.params.lang as Lang;const {work}=Astro.props;const copy=work[lang];const zh=lang==='zh';
---
<Base lang={lang} title={copy.title} description={copy.summary} area="works"><div class="container detail-back"><a class="text-link" href={href(lang,'works')}>← {zh?'项目与案例':'Projects & case studies'}</a></div><section class="container page-intro"><p class="eyebrow">{copy.kind}</p><h1>{copy.title}</h1><p>{copy.summary}</p></section><article class="container detail-content"><h2>{zh?'问题与背景':'The challenge'}</h2><p>{copy.challenge}</p><h2>{zh?'实现思路':'The approach'}</h2><p>{copy.approach}</p><h2>{zh?'形成的成果':'The result'}</h2><p>{copy.outcome}</p><h2>{zh?'公开项目资料':'Project references'}</h2><ul>{work.productIds.map((id:string)=>products.find(p=>p.id===id)).map((product:typeof products[number])=><li><a href={product.repo+'#readme'} target="_blank" rel="noopener noreferrer">{product.name} README</a></li>)}</ul><RelatedContent contentKey={'work:'+work.id} lang={lang}/></article></Base>
