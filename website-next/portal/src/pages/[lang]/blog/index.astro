---
import Base from '../../../layouts/Base.astro';import Icon from '../../../components/Icon.astro';import{languages,products,ui,links,href,type Lang}from'../../../data/site';export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}const lang=Astro.params.lang as Lang;const zh=lang==='zh';
---
<Base lang={lang} title={ui[lang].blog} area="blog"><section class="container page-intro"><p class="eyebrow">NOTES FROM DEVELOPMENT</p><h1>{zh?'记录问题，也记录解法。':'Notes on problems and solutions.'}</h1><p>{zh?'技术文章与开发记录目前发布在博客园。工具的快速上手说明，整理在本站文档中。':'My technical articles and development notes are published on CNBlogs. Quick starts for the tools live in this site’s documentation.'}</p></section><section class="container journal-card"><div><p class="eyebrow">CNBLOGS</p><h2>{zh?'我的技术博客':'The technical journal'}</h2><p>{zh?'Unreal Engine、工具开发与实际项目中的经验记录。沿着具体问题，留下可以再次查阅的思路。':'Notes on Unreal Engine, tool development, and lessons from practical work—organized around concrete problems.'}</p></div><a class="button button-blue" href={links.blog} target="_blank" rel="noopener noreferrer">{zh?'前往博客园阅读':'Read on CNBlogs'}<Icon name="external"/></a></section><section class="container journal-guides"><div class="section-heading"><div><p class="eyebrow">PRACTICAL GUIDES</p><h2>{zh?'工具使用指南':'Practical tool guides'}</h2></div></div>{products.map(product=><a class="guide-row" href={href(lang,'docs','tools/'+product.id)}><div><strong>{product.name}</strong><span>{product[lang].label}</span></div><Icon/></a>)}</section></Base>
