---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import BlogSearch from '../../../components/BlogSearch.astro';
import {languages,ui,links,href,type Lang} from '../../../data/site';
import {getPublishedPosts,postHref} from '../../../../../shared/blog';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;const zh=lang==='zh';
const posts=(await getPublishedPosts()).filter(post=>post.data.lang===lang);
const tags=[...new Set(posts.flatMap(post=>post.data.tags))].sort();
---
<Base lang={lang} title={ui[lang].blog} area="blog"><section class="container page-intro"><p class="eyebrow">NOTES FROM DEVELOPMENT</p><h1>{zh?'记录问题，也记录解法。':'Notes on problems and solutions.'}</h1><p>{zh?'工具开发、技术思路与实践记录。文章连接相关产品、作品和使用文档，方便继续查阅。':'Notes on tools, technical choices, and practical work, connected to the relevant products, case studies, and guides.'}</p><div class="journal-links"><a class="text-link" href={href(lang,'blog')+'rss.xml'}>RSS</a><a class="text-link" href={links.blog} target="_blank" rel="noopener noreferrer">{zh?'博客园旧文':'Earlier posts on CNBlogs'}<Icon name="external" size={16}/></a></div></section><section class="container journal-guides"><BlogSearch lang={lang} tags={tags}/><div class="article-list" data-article-list>{posts.map(post=><article class="article-card" data-article-tags={JSON.stringify(post.data.tags)}><div class="article-meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time>{post.data.tags.map(tag=><a class="article-tag" href={href(lang,'blog')+'?tag='+encodeURIComponent(tag)}>{tag}</a>)}</div><h2><a href={postHref(post)}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="text-link" href={postHref(post)}>{zh?'阅读全文':'Read article'}<Icon size={17}/></a></article>)}</div>{posts.length===0&&<p>{zh?'新文章正在整理，先到博客园看看之前的记录。':'New articles are being prepared. Earlier posts are available on CNBlogs.'}</p>}<p data-tag-empty hidden>{zh?'这个标签下暂时没有文章。':'No articles with this tag yet.'}</p></section></Base>
