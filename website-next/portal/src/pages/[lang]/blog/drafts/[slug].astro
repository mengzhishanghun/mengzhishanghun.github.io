---
import BlogArticle from '../../../../components/BlogArticle.astro';
import {getPosts,isPublished} from '../../../../../../shared/blog';
export async function getStaticPaths(){return process.env.PREVIEW_DRAFTS==='1'?(await getPosts()).filter(post=>!isPublished(post)).map(post=>({params:{lang:post.data.lang,slug:post.data.slug},props:{post}})):[];}
const {post}=Astro.props;
---
<BlogArticle post={post} draftPreview/>
