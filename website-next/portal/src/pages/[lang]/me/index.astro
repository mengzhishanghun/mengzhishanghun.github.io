---
import Base from '../../../layouts/Base.astro';import Icon from '../../../components/Icon.astro';import {ui,languages,products,works,links,href,type Lang} from '../../../data/site';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}const lang=Astro.params.lang as Lang;const t=ui[lang];const zh=lang==='zh';
const services=zh?[['插件与工具定制','把重复操作整理成适合项目的工具，覆盖编辑器扩展与工作流自动化。','code'],['UE 功能开发','围绕 Unreal Engine 的功能实现、引擎升级与项目技术问题。','box'],['交互与仿真项目','结合实际设备、数据和场景，让交互流程在项目里运行起来。','book'],['技术咨询','从需求范围、实现思路到交付边界，先把问题与目标讲清楚。','mail']]:[['Custom plugins & tools','Editor extensions and automation built around your project’s workflow.','code'],['Unreal Engine development','Features, engine upgrades, and project-specific technical work.','box'],['Interactive applications','Connect devices, data, and scenes into usable interactive experiences.','book'],['Technical consultation','Clarify scope, implementation options, and delivery expectations.','mail']];
---
<Base lang={lang} title={t.me} area="me"><section class="container about-hero"><div class="about-identity"><img class="profile-avatar" src="/assets/github-avatar.png" width="164" height="164" alt={zh?"我的 GitHub 头像":"My GitHub avatar"}/><div><p class="eyebrow">HELLO, I’M XIAOMAO</p><h1>{zh?'你好，我是小毛。':'Hi, I’m Xiaomao.'}</h1><p class="about-lead">{zh?'一名自由开发者，主要做插件、工具与交互项目开发。':'An independent developer building plugins, tools, and interactive applications.'}</p><p class="muted">{zh?'网上使用「梦之殇魂」这个名字，交流时叫我小毛就好。':'You may know my work as MZSH / mengzhishanghun. Feel free to call me Xiaomao.'}</p><div class="button-row"><a class="button button-blue" href="#contact">{t.contact}<Icon/></a><a class="button button-plain" href={href(lang,'projects')}>{t.projects}<Icon/></a></div></div></div></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">WHAT I DO</p><h2>{zh?'合作方向':'How I can help'}</h2></div></div><div class="service-grid">{services.map(([title,description,icon])=><article class="service-card"><Icon name={icon} size={27}/><h3>{title}</h3><p>{description}</p></article>)}</div></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2>{zh?'代表实践':'Selected work'}</h2><p>{zh?'把自己反复遇到的问题，做成可以重复使用的工具。':'Turning recurring development problems into reusable tools.'}</p></div></div><div class="case-list">{works.map((work,i)=><article class="case-row"><span class="case-number">0{i+1}</span><div><p class="eyebrow">{work[lang].kind}</p><h3>{work[lang].title}</h3><p>{work[lang].challenge}</p><p class="case-result">{work[lang].outcome}</p></div><a class="text-link" href={href(lang,'works',work.id)}>{zh?'查看作品':'View case study'}<Icon/></a></article>)}</div></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">WORKING TOGETHER</p><h2>{zh?'如何开始合作':'Working together'}</h2></div></div><ol class="process-grid">{(zh?[['沟通目标','先聊清楚要解决的问题、使用场景和现有条件。'],['确认范围','明确交付内容、时间安排、报价与验收方式。'],['分阶段交付','按约定提供可查看的成果，及时对齐反馈。'],['验收与维护','完成约定验收，明确文档和后续维护范围。']]:[['Discuss the goal','Share the problem, use case, and your existing setup.'],['Agree on scope','Define deliverables, timing, pricing, and acceptance.'],['Deliver in stages','Review tangible progress and align on feedback.'],['Review & hand over','Complete acceptance, documentation, and agreed maintenance.']]).map(([title,text],i)=><li><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></section>
<section class="container background-strip"><h2>{zh?'一些背景':'A little background'}</h2><p>{zh?'我的工作经历涉及 UE 游戏研发、编辑器工具、仿真与沉浸式交互。现在以自由开发者的方式，继续打磨工具，也参与合适的定制项目。':'My experience spans Unreal Engine game development, editor tools, simulation, and immersive interaction. I now work independently on useful tools and selected custom projects.'}</p></section>
<section class="container contact-section" id="contact"><div><p class="eyebrow">SAY HELLO</p><h2>{zh?'有想做的东西？聊聊看。':'Have a project in mind?'}</h2><p>{zh?'可以先告诉我项目目标、现有情况、期望时间和预算范围。产品问题请附上工具名称、版本及复现步骤。':'Tell me your goal, current setup, timeline, and budget range. For product questions, include the tool, version, and steps to reproduce.'}</p></div><div class="contact-actions"><a class="email-link" href={'mailto:'+links.email}>{links.email}<Icon name="external"/></a><a class="text-link" href={links.contact} target="_blank" rel="noopener noreferrer">{zh?'更多联系渠道与技术交流群':'More contact options & community'}<Icon size={17}/></a><small>{zh?'合作咨询 · 产品反馈 · 技术交流':'Collaboration · Product feedback · Technical discussion'}</small></div></section></Base>
