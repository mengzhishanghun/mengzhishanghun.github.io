---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import RelatedContent from '../../../../../shared/RelatedContent.astro';
import {languages,products,ui,href,type Lang} from '../../../data/site';
export function getStaticPaths(){return languages.flatMap(lang=>products.map(product=>({params:{lang,slug:product.id},props:{product}})));}
const lang=Astro.params.lang as Lang;const {product}=Astro.props;const detail=product[lang];const t=ui[lang];const zh=lang==='zh';
---
<Base lang={lang} title={product.name} description={detail.description} area="projects">
<div class="container detail-back"><a class="text-link" href={href(lang,'projects')}>← {t.projects}</a></div>
<section class="container detail-hero"><div><p class="eyebrow">{detail.label} · {product.license??(zh?'公开源码':'Public source')}</p><h1>{product.name}</h1><p>{detail.description}</p><div class="button-row"><a class="button button-blue" href={product.download??product.repo+'#readme'} target="_blank" rel="noopener noreferrer">{product.download?t.download:t.source}<Icon name="external"/></a>{product.docPath&&<a class="button button-outline" href={href(lang,'docs',product.docPath)}>{t.readDocs}<Icon name="book"/></a>}</div></div><aside class={'detail-summary '+product.color}><span class="product-mark">{product.mark}</span><ul class="feature-list">{detail.features.map((feature:string)=><li><Icon name="check" size={19}/><span>{feature}</span></li>)}</ul></aside></section>
<article class="container detail-content"><h2>{zh?'解决什么问题':'The problem it addresses'}</h2><p>{detail.problem}</p><p>{detail.result}</p><h2>{zh?'快速开始':'Quick start'}</h2><ol>{detail.steps.map((step:string)=><li>{step}</li>)}</ol><h2>{zh?'源码与使用说明':'Source and reference'}</h2><p>{zh?'安装方式、依赖、支持范围与许可条款，以公开仓库的 README、LICENSE 和发布说明为准。':'See the repository README, license, and release notes for installation, dependencies, and supported configurations.'}</p><p><a href={product.repo+'#readme'} target="_blank" rel="noopener noreferrer">{t.source}</a></p><RelatedContent contentKey={'product:'+product.id} lang={lang}/></article>
</Base>
