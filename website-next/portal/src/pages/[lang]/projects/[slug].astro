---
import Base from '../../../layouts/Base.astro';import Icon from '../../../components/Icon.astro';import{languages,products,ui,href,type Lang}from'../../../data/site';export function getStaticPaths(){return languages.flatMap(lang=>products.map(product=>({params:{lang,slug:product.id},props:{product}})));}const lang=Astro.params.lang as Lang;const {product}=Astro.props;const detail=product[lang];const t=ui[lang];const zh=lang==='zh';
---
<Base lang={lang} title={product.name} description={detail.description} area="projects"><div class="container detail-back"><a class="text-link" href={href(lang,'projects')}>← {t.projects}</a></div><section class="container detail-hero"><div><p class="eyebrow">{detail.label}</p><h1>{product.name}</h1><p>{detail.description}</p><div class="button-row"><a class="button button-blue" href={product.repo+'/releases'} target="_blank" rel="noopener noreferrer">{t.download}<Icon name="external"/></a><a class="button button-outline" href={href(lang,'docs','tools/'+product.id)}>{t.readDocs}<Icon name="book"/></a></div></div><aside class={'detail-summary '+product.color}><span class="product-mark">{product.mark}</span><ul class="feature-list">{detail.features.map((feature:string)=><li><Icon name="check" size={19}/><span>{feature}</span></li>)}</ul></aside></section><article class="container detail-content"><h2>{zh?'解决什么问题':'The problem it addresses'}</h2><p>{detail.problem}</p><p>{detail.result}</p><h2>{zh?'快速开始':'Quick start'}</h2><ol>{detail.steps.map((step:string)=><li>{step}</li>)}</ol><h2>{zh?'版本与使用说明':'Versions and reference'}</h2><p>{zh?'提供 Windows 程序下载。实际依赖、支持范围与完整使用说明，请查看仓库 README 和 Release 发布说明。':'A Windows download is available. Check the repository README and release notes for requirements, supported configurations, and complete instructions.'}</p><p><a href={product.repo+'#readme'} target="_blank" rel="noopener noreferrer">{t.source}</a> · <a href={href(lang,'docs','tools/'+product.id)}>{t.readDocs}</a></p></article></Base>
