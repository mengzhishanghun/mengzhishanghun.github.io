---
import Base from '../../../layouts/Base.astro';import Icon from '../../../components/Icon.astro';import ProductCard from '../../../components/ProductCard.astro';import{languages,products,ui,links,type Lang}from'../../../data/site';export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}const lang=Astro.params.lang as Lang;const t=ui[lang];const zh=lang==='zh';
---
<Base lang={lang} title={t.projects} area="projects"><section class="container page-intro"><p class="eyebrow">PRODUCTS</p><h1>{zh?'实用工具，来自实际需求。':'Useful tools, built from real needs.'}</h1><p>{zh?'插件、开源工具与开发辅助软件。找到需要的产品，再查看文档、开发案例与相关文章。':'Plugins, open-source tools, and development utilities. Find a product, then explore its guides, case studies, and articles.'}</p></section><section class="container catalog-section"><div class="product-grid">{products.map(product=><ProductCard product={product} lang={lang}/>)}</div></section><section class="container store-strip"><div><p class="eyebrow">UNREAL ENGINE PLUGINS</p><h2>{zh?'更多商业插件，前往 Fab。':'More plugins on Fab.'}</h2><p>{zh?'网络通信、资产管理与开发辅助类插件。具体功能、版本和购买信息，以商店中的产品页面为准。':'Networking, asset management, and development utilities. Refer to each store listing for features, supported versions, and purchase information.'}</p></div><a class="button button-dark" href={links.fab} target="_blank" rel="noopener noreferrer">{zh?'浏览 Fab 商店':'Browse Fab'}<Icon name="external"/></a></section></Base>
