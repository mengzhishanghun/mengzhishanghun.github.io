---
import Base from '../../layouts/Base.astro';import Icon from '../../components/Icon.astro';import ProductCard from '../../components/ProductCard.astro';import {ui,languages,products,links,href,type Lang} from '../../data/site';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}const lang=Astro.params.lang as Lang;const t=ui[lang];const zh=lang==='zh';
---
<Base lang={lang}><section class="container hero"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line"></span>{t.intro}</p><h1><span>{zh?'为开发者制作':'Practical tools.'}</span><span class="accent-text">{zh?'实用的插件与工具。':'Better workflows.'}</span></h1><p class="hero-description">{t.description}</p><div class="button-row"><a class="button button-blue" href="#tools">{t.explore}<Icon/></a><a class="button button-plain" href={href(lang,'me')}>{zh?'认识我':'Get to know me'}<Icon/></a></div><div class="hero-disciplines"><span>Unreal Engine</span><span>C++</span><span>Automation</span></div></div><aside class="toolbox"><div class="toolbox-heading"><span class="mono">MZSH / TOOLBOX</span><span>01—03</span></div><h2>{zh?'我的开发工具箱':'The developer’s toolbox'}</h2><p>{zh?'构建、管理、整理，让流程连贯起来。':'Build, manage, and prepare. Keep your workflow moving.'}</p><div class="toolbox-list">{products.map(product=><a class="toolbox-item" href={href(lang,'projects',product.id)}><span class={'mini-mark '+product.color}>{product.mark}</span><span><strong>{product.name}</strong><small>{product[lang].label}</small></span><Icon size={18}/></a>)}</div><div class="toolbox-footer"><Icon name="code" size={16}/><span>{zh?'从实际需求出发，持续打磨。':'Built from real needs. Refined over time.'}</span></div></aside></section>
<section class="container tools-section" id="tools"><div class="section-heading"><div><p class="eyebrow">THE TOOLBOX</p><h2>{t.selected}</h2><p>{zh?'从日常开发中的实际问题出发，让工作顺手一点。':'Built around real problems encountered in everyday development.'}</p></div><a class="text-link" href={href(lang,'projects')}>{t.all}<Icon/></a></div><div class="product-grid">{products.map(product=><ProductCard product={product} lang={lang}/>)}</div></section>
<section class="container ecosystem"><div class="section-heading"><div><p class="eyebrow">EXPLORE MZSH</p><h2>{zh?'从一个入口，找到需要的内容。':'Find what you need, in one place.'}</h2></div></div><div class="entry-grid"><a href={href(lang,'docs')} class="entry-card"><span class="entry-icon"><Icon name="book" size={25}/></span><h3>{t.docs}</h3><p>{zh?'安装、快速上手与使用说明。':'Installation, quick starts, and practical guides.'}</p><Icon/></a><a href={href(lang,'blog')} class="entry-card"><span class="entry-icon"><Icon name="code" size={25}/></span><h3>{t.blog}</h3><p>{zh?'开发经验、技术文章与过程记录。':'Development experience and notes from the work.'}</p><Icon/></a><a href={links.fab} target="_blank" rel="noopener noreferrer" class="entry-card"><span class="entry-icon"><Icon name="box" size={25}/></span><h3>{zh?'Fab 插件商店':'Plugins on Fab'}</h3><p>{zh?'浏览商业插件及平台上的产品信息。':'Explore commercial plugins and their listings.'}</p><Icon name="external"/></a></div></section>
<section class="container collaboration-banner"><div><p class="eyebrow">LET’S BUILD SOMETHING</p><h2>{zh?'不止于工具，也一起解决问题。':'Have something worth building?'}</h2><p>{zh?'插件定制、工作流自动化与交互项目开发。带着你的目标来，我们一起把需求梳理清楚。':'Custom plugins, workflow automation, and interactive development. Let’s start with the problem you want to solve.'}</p></div><a class="button button-dark" href={href(lang,'me')+'#contact'}>{t.contact}<Icon/></a></section></Base>
