---
import Base from '../../layouts/Base.astro';
import MasterDetail from '../../components/MasterDetail.astro';
import { workItems } from '../../data/master-items';
export function getStaticPaths(){return workItems.map(item=>({params:{slug:item.id},props:{item}}));}
const { item } = Astro.props;
---
<Base title={item.title} description={item.description} area="works"><div class="master-page"><header class="shell master-page-head"><h1>作品</h1><p>插件、工具与项目记录。</p></header><section class="shell master-page-body"><MasterDetail items={workItems} selectedId={item.id} label="作品列表" baseHref="/works/"/></section></div></Base>
