---
import Base from '../../layouts/Base.astro'; import { products } from '../../data/site';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.id},props:{product}}));} const { product } = Astro.props;
---
<Base title={product.name} area="works" description={product.zh.description}><article class="shell detail"><a class="text-link" href="/works/">← 返回作品</a><p class="eyebrow">{product.zh.label}</p><h1>{product.name}</h1><p>{product.zh.description}</p><h2>作品内容</h2><ul>{product.zh.features.map((item:string)=><li>{item}</li>)}</ul><h2>解决的问题</h2><p>{product.zh.problem}</p><p>{product.zh.result}</p>{product.docPath&&<p><a class="text-link" href={'/docs/zh/'+product.docPath+'/'}>使用文档 →</a></p>}{product.repo&&<p><a class="text-link" href={product.repo+'#readme'} target="_blank" rel="noopener noreferrer">源码与说明 →</a></p>}</article></Base>
