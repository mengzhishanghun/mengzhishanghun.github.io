---
import Base from '../../layouts/Base.astro'; import { cases } from '../../data/site';
export function getStaticPaths(){return cases.map(item=>({params:{slug:item.id},props:{item}}));} const { item } = Astro.props;
---
<Base title={item.zh.title} area="cases" description={item.zh.summary}><article class="shell detail"><a class="text-link" href="/cases/">← 返回案例</a><p class="eyebrow">{item.zh.kind}</p><h1>{item.zh.title}</h1><p>{item.zh.summary}</p><h2>背景</h2><p>{(item.zh as Record<string,string>).background ?? (item.zh as Record<string,string>).challenge}</p><h2>主要方案</h2><p>{item.zh.approach}</p><h2>最终效果</h2><p>{item.zh.outcome}</p></article></Base>
