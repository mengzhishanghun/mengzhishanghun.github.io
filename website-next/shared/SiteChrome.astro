---
interface Props { area?: string; docs?: boolean; contentTag?: 'main' | 'div'; }
const { area = '', docs = false, contentTag = 'main' } = Astro.props;
const ContentTag = contentTag;
const nav = [['/', '首页', 'home'], ['/works/', '作品', 'works'], ['/cases/', '案例', 'cases'], ['/blog/', '博客', 'blog']];
---
<div class:list={['site-chrome', {'site-chrome-docs': docs}]}>
  <a class="skip-link" href="#main">跳到主要内容</a>
  <header class="site-header" transition:persist="site-header">
    <div class="shell header-inner">
      <a class="brand" href="/" aria-label="梦之殇魂首页">MZSH</a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="main-navigation">菜单</button>
      <nav id="main-navigation" class="main-nav" aria-label="主导航">{nav.map(([href, label, key]) => <a href={href} aria-current={area === key ? 'page' : undefined}>{label}</a>)}</nav>
      <div class="header-actions"><a href="/contact/" aria-current={area === 'contact' ? 'page' : undefined}>联系</a><a href="/support/" aria-current={area === 'support' ? 'page' : undefined}>支持</a></div>
    </div>
  </header>
  <ContentTag id={contentTag === 'main' ? 'main' : undefined} class:list={['site-chrome-main', {'home-main': area === 'home'}]}><slot /></ContentTag>
  <footer class="site-footer" transition:persist="site-footer"><div class="shell legal-footer"><span><strong>MZSH</strong>　© 2026 MZSH. 保留所有权利。</span><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">晋ICP备2026011728号-1</a><a href="https://beian.mps.gov.cn/" target="_blank" rel="noopener noreferrer">晋公网安备14082502000144号</a></div></footer>
</div>
<script is:inline>
  if (!document.documentElement.dataset.siteChromeBound) {
    document.documentElement.dataset.siteChromeBound = 'true';
    const update = () => {
      const header = document.querySelector('.site-chrome .site-header');
      if (!header) return;
      const path = location.pathname;
      header.querySelectorAll('.main-nav a, .header-actions a').forEach(link => {
        const href = link.getAttribute('href') || '';
        link.toggleAttribute('aria-current', href === '/' ? path === '/' : path.startsWith(href));
      });
      header.querySelector('[data-menu-toggle]')?.setAttribute('aria-expanded', 'false');
      header.querySelector('.main-nav')?.classList.remove('is-open');
    };
    document.addEventListener('click', event => {
      const button = event.target.closest?.('[data-menu-toggle]');
      if (!button) return;
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      button.closest('.site-header')?.querySelector('.main-nav')?.classList.toggle('is-open', open);
    });
    document.addEventListener('astro:after-swap', update);
    update();
  }
</script>
<style is:global>
  .site-chrome{--chrome-bg:#07101d;--chrome-panel:#0c1828;--chrome-text:#e9f2ff;--chrome-muted:#a8bad0;--chrome-line:#304861;--chrome-blue:#6bc7ff;--site-chrome-header-height:70px;--site-chrome-footer-height:56px;height:100dvh;min-height:0;display:grid;grid-template-rows:var(--site-chrome-header-height) minmax(0,1fr) var(--site-chrome-footer-height);background:var(--bg,var(--chrome-bg));color:var(--text,var(--chrome-text))}
  .site-chrome .skip-link{position:fixed;top:-60px;left:12px;z-index:99;background:#fff;color:#000;padding:9px}.site-chrome .skip-link:focus{top:12px}
  .site-chrome-main{min-width:0;min-height:0;overflow-x:hidden;overflow-y:auto}.site-chrome-docs .site-chrome-main{padding:0}
  .site-chrome .shell{width:min(var(--max,1160px),calc(100% - 48px));margin:auto}
  .site-chrome .site-header{z-index:20;background:#07101de8;border-bottom:1px solid var(--line,var(--chrome-line));backdrop-filter:blur(14px)}
  .site-chrome .header-inner{height:70px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px}
  .site-chrome .brand{justify-self:start;color:inherit;text-decoration:none;font-size:1.55rem;font-weight:850;letter-spacing:.04em}
  .site-chrome .main-nav{display:flex;align-items:center;gap:34px;margin:0}.site-chrome .main-nav a{color:var(--muted,var(--chrome-muted));font-size:.95rem;text-decoration:none}
  .site-chrome .main-nav a:hover,.site-chrome .main-nav a[aria-current=page]{color:var(--text,var(--chrome-text))}
  .site-chrome .main-nav a[aria-current=page]{border-bottom:2px solid var(--blue,var(--chrome-blue));padding-bottom:5px;margin-bottom:-7px}
  .site-chrome .header-actions{justify-self:end;display:flex;align-items:center;gap:12px}.site-chrome .header-actions a{display:inline-flex;align-items:center;justify-content:center;min-width:76px;min-height:40px;border:1px solid transparent;border-radius:7px;color:var(--text,var(--chrome-text));text-decoration:none;font-weight:650}.site-chrome .header-actions a:hover,.site-chrome .header-actions a[aria-current=page]{border-color:#5ca9ec;background:linear-gradient(135deg,#294f7d,#12335a)}
  .site-chrome .menu-toggle{display:none;background:none;color:inherit;border:1px solid var(--line,var(--chrome-line));border-radius:6px;padding:6px 12px;min-height:44px}
  .site-chrome .site-footer{border-top:1px solid var(--line,var(--chrome-line));background:#06101be8}.site-chrome .legal-footer{height:100%;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1fr);align-items:center;font-size:.78rem;color:var(--muted,var(--chrome-muted))}.site-chrome .legal-footer>*{min-width:0;overflow-wrap:anywhere}.site-chrome .legal-footer strong{color:var(--text,var(--chrome-text));font-size:1rem;letter-spacing:.04em}.site-chrome .legal-footer a{color:inherit;text-decoration:none}.site-chrome .legal-footer a:hover{text-decoration:underline}.site-chrome .legal-footer a:nth-child(2){text-align:center;border-inline:1px solid var(--line,var(--chrome-line))}.site-chrome .legal-footer a:last-child{text-align:right}
  .site-chrome :where(a,button):focus-visible{outline:2px solid var(--blue,var(--chrome-blue));outline-offset:3px}
  @media(max-width:720px){.site-chrome{--site-chrome-header-height:60px;--site-chrome-footer-height:64px}.site-chrome .shell{width:min(100% - 32px,var(--max,1160px))}.site-chrome .header-inner{height:60px;grid-template-columns:1fr auto auto;gap:10px}.site-chrome .menu-toggle{display:block;grid-column:2;grid-row:1}.site-chrome .header-actions{grid-column:3;grid-row:1;gap:2px}.site-chrome .header-actions a{min-width:44px;min-height:44px;font-size:.82rem}.site-chrome .main-nav{display:none;position:absolute;top:60px;left:0;right:0;background:var(--panel,var(--chrome-panel));padding:16px 24px;border-bottom:1px solid var(--line,var(--chrome-line))}.site-chrome .main-nav.is-open{display:grid;gap:14px}.site-chrome .main-nav a[aria-current=page]{margin:0;padding:0;border:0}.site-chrome .legal-footer{font-size:.64rem;gap:7px}.site-chrome .legal-footer strong{font-size:.78rem}}
</style>
