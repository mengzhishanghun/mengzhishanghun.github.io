---
interface Props { area?: string; docs?: boolean; contentTag?: 'main' | 'div'; }
const { area = '', docs = false, contentTag = 'main' } = Astro.props;
const ContentTag = contentTag;
const nav = [['/', '首页', 'home'], ['/works/', '作品', 'works'], ['/cases/', '案例', 'cases'], ['/blog/', '博客', 'blog']];
const email = 'mzsh.me@icloud.com';
---
<div class:list={['site-chrome', {'site-chrome-docs': docs}]}>
  <a class="skip-link" href="#main">跳到主要内容</a>
  <header class="site-header" transition:persist="site-header"><div class="shell header-inner"><a class="brand" href="/" aria-label="梦之殇魂首页">MZSH</a><button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="main-navigation">菜单</button><nav id="main-navigation" class="main-nav" aria-label="主导航">{nav.map(([href,label,key])=><a href={href} aria-current={area===key?'page':undefined}>{label}</a>)}</nav></div></header>
  <ContentTag id={contentTag === 'main' ? 'main' : undefined} class:list={['site-chrome-main', {'home-main': area === 'home'}]}><slot/></ContentTag>
  <footer class="site-footer" transition:persist="site-footer"><div class="shell legal-footer"><span>© 2026 MZSH</span><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">晋ICP备2026011728号-1</a><a href="https://beian.mps.gov.cn/" target="_blank" rel="noopener noreferrer">晋公网安备14082502000144号</a></div></footer>
  <div class="floating-actions" transition:persist="site-actions"><button type="button" data-open-dialog="contact">✉<span>联系</span></button><button type="button" data-open-dialog="support">♡<span>支持</span></button></div>
  <dialog data-quick-dialog transition:persist="site-dialog"><button class="dialog-close" data-dialog-close aria-label="关闭">×</button><section data-dialog-panel="contact"><h2>联系我</h2><p>合作咨询、作品反馈或技术交流，可通过下面的方式联系。</p><div class="contact-email"><span>邮箱</span><a class="email-link" href={'mailto:'+email}>{email}</a><button type="button" class="copy-email" data-copy-email>复制</button><small data-copy-feedback role="status"></small></div><p class="wechat-note">扫码添加微信 →</p><div class="code-placeholder">个人微信二维码<br/>待替换</div></section><section data-dialog-panel="support" hidden><h2>支持创作</h2><p>如果这些作品或文章对你有帮助，可以自愿支持我继续创作。</p><div class="support-codes"><div class="code-placeholder">微信赞赏码<br/>待替换</div><div class="code-placeholder">支付宝收款码<br/>待替换</div></div><small>自愿支持，不对应商品或服务。</small></section></dialog>
</div>
<script>const chromeNavHeader=document.querySelector('[data-astro-transition-persist="site-header"]');if(chromeNavHeader&&!chromeNavHeader.dataset.ariaBound){chromeNavHeader.dataset.ariaBound='true';const syncAriaCurrent=()=>{const path=location.pathname;chromeNavHeader.querySelectorAll('.main-nav a').forEach(link=>{const href=link.getAttribute('href')||'';if(href==='/'?path==='/':path.startsWith(href))link.setAttribute('aria-current','page');else link.removeAttribute('aria-current')})};document.addEventListener('astro:after-swap',syncAriaCurrent);syncAriaCurrent()}</script>
<script define:vars={{email}}>const header=document.querySelector('[data-astro-transition-persist="site-header"]');if(header&&!header.dataset.bound){header.dataset.bound='true';const menu=header.querySelector('[data-menu-toggle]'),nav=header.querySelector('.main-nav'),dialog=document.querySelector('[data-quick-dialog]'),feedback=document.querySelector('[data-copy-feedback]');const updateNavigation=()=>{const path=location.pathname;header.querySelectorAll('.main-nav a').forEach(link=>{const href=link.getAttribute('href')||'';link.toggleAttribute('aria-current',href==='/'?path==='/':path.startsWith(href))});menu?.setAttribute('aria-expanded','false');nav?.classList.remove('is-open')};menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open)});document.querySelectorAll('[data-open-dialog]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-dialog-panel]').forEach(panel=>panel.toggleAttribute('hidden',panel.getAttribute('data-dialog-panel')!==button.getAttribute('data-open-dialog')));dialog?.showModal()}));document.querySelector('[data-dialog-close]')?.addEventListener('click',()=>dialog?.close());dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});document.querySelector('[data-copy-email]')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(email);if(feedback)feedback.textContent='邮箱已复制'}catch{if(feedback)feedback.textContent='请手动复制邮箱'}});addEventListener('astro:after-swap',updateNavigation);updateNavigation()}</script>
<style is:global>.site-chrome{--chrome-bg:#07101d;--chrome-panel:#0c1828;--chrome-text:#e9f2ff;--chrome-muted:#91a4ba;--chrome-line:#263a50;--chrome-blue:#6bc7ff;--site-chrome-header-height:70px;--site-chrome-footer-height:43px;height:100dvh;min-height:0;display:grid;grid-template-rows:var(--site-chrome-header-height) minmax(0,1fr) var(--site-chrome-footer-height);background:var(--bg,var(--chrome-bg));color:var(--text,var(--chrome-text))}.site-chrome .skip-link{position:fixed;top:-60px;left:12px;z-index:99;background:#fff;color:#000;padding:9px}.site-chrome .skip-link:focus{top:12px}.site-chrome-main{min-width:0;min-height:0;overflow-x:hidden;overflow-y:auto}.site-chrome-docs .site-chrome-main{padding:0}.site-chrome .shell{width:min(var(--max,1160px),calc(100% - 48px));margin:auto}.site-chrome .site-header{z-index:20;background:#07101de8;border-bottom:1px solid var(--line,var(--chrome-line));backdrop-filter:blur(14px)}.site-chrome .header-inner{height:70px;display:flex;align-items:center}.site-chrome .brand{color:inherit;text-decoration:none;font-size:1.35rem;font-weight:850;letter-spacing:-.08em}.site-chrome .main-nav{display:flex;gap:34px;margin-left:auto}.site-chrome .main-nav a{color:var(--muted,var(--chrome-muted));font-size:.95rem;text-decoration:none}.site-chrome .main-nav a:hover,.site-chrome .main-nav a[aria-current=page]{color:var(--blue,var(--chrome-blue))}.site-chrome .menu-toggle{display:none;margin-left:auto;background:none;color:inherit;border:1px solid var(--line,var(--chrome-line));border-radius:6px;padding:5px 9px}.site-chrome .site-footer{border-top:1px solid var(--line,var(--chrome-line));background:#06101b}.site-chrome .legal-footer{height:42px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1fr);align-items:center;font-size:.78rem;color:var(--muted,var(--chrome-muted))}.site-chrome .legal-footer>*{min-width:0;overflow-wrap:anywhere}.site-chrome .legal-footer a{color:inherit;text-decoration:none}.site-chrome .legal-footer a:nth-child(2){text-align:center}.site-chrome .legal-footer a:last-child{text-align:right}.site-chrome .floating-actions{position:fixed;right:0;top:55%;z-index:30;display:grid;gap:5px}.site-chrome .floating-actions button{width:42px;height:72px;border:1px solid var(--line,var(--chrome-line));border-right:0;border-radius:8px 0 0 8px;background:var(--panel,var(--chrome-panel));color:inherit;display:grid;place-items:center}.site-chrome .floating-actions span{writing-mode:vertical-rl;font-size:.75rem}.site-chrome dialog{width:min(440px,calc(100% - 30px));border:1px solid var(--line,var(--chrome-line));border-radius:12px;background:var(--panel,var(--chrome-panel));color:inherit;padding:30px}.site-chrome dialog::backdrop{background:#000a}.site-chrome .dialog-close{position:absolute;right:10px;top:8px;border:0;background:transparent;color:inherit;font-size:1.6rem}.site-chrome .contact-email{display:flex;align-items:center;gap:10px;margin:17px 0 10px}.site-chrome .email-link{color:var(--blue,var(--chrome-blue))}.site-chrome .copy-email{border:1px solid var(--line,var(--chrome-line));border-radius:5px;background:#13243a;color:inherit;padding:3px 10px;font-size:.8rem}.site-chrome .contact-email small{color:var(--blue,var(--chrome-blue))}.site-chrome .wechat-note{font-size:.87rem;margin-bottom:8px}.site-chrome .code-placeholder{width:132px;height:132px;border:1px dashed var(--line,var(--chrome-line));display:grid;place-items:center;text-align:center;color:var(--muted,var(--chrome-muted));font-size:.78rem}.site-chrome .support-codes{display:flex;gap:18px;margin:17px 0}@media(max-width:720px){.site-chrome{--site-chrome-header-height:60px;--site-chrome-footer-height:47px}.site-chrome .shell{width:min(100% - 32px,var(--max,1160px))}.site-chrome .header-inner{height:60px}.site-chrome .menu-toggle{display:block}.site-chrome .main-nav{display:none;position:absolute;top:60px;left:0;right:0;background:var(--panel,var(--chrome-panel));padding:16px 24px;border-bottom:1px solid var(--line,var(--chrome-line))}.site-chrome .main-nav.is-open{display:grid;gap:14px}.site-chrome .legal-footer{height:46px;font-size:.68rem;gap:6px}.site-chrome .floating-actions button{width:39px}}</style>
