{
  "name": "mzsh-website-preview",
  "private": true,
  "type": "module",
  "workspaces": [
    "portal",
    "docs"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace portal && node scripts/search.mjs && npm run build --workspace docs && node scripts/combine.mjs",
    "check": "npm run check --workspace portal && npm run check --workspace docs",
    "test:content": "node --experimental-strip-types tests/content-media.mjs && node --experimental-strip-types tests/content-search.mjs",
    "preview": "node scripts/preview.mjs",
    "stop": "node scripts/dev.mjs stop",
    "status": "node scripts/dev.mjs status"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "1.5.2",
    "typescript": "^6.0.3"
  }
}
